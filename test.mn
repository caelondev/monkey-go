fn fib(n, cache) {
    if (n <= 1) {
        return n;
    }
    var cache_data = cache[n];
    if (not is_nil(cache_data)) {
        return cache_data;
    }
    var result = fib(n-1, cache) + fib(n-2, cache);
    cache[n] = result;
    return result;
}

var fib_val = prompt("Enter a fibbonacci number: ");
fib_val = to_number(fib_val);

var total = fib(fib_val, {});
print("Fib " + to_string(fib_val) + " = " + to_string(total));
